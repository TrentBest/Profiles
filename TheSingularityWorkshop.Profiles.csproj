<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>TheSingularityWorkshop.Profiles</AssemblyName>
    <RootNamespace>TheSingularityWorkshop.Profiles</RootNamespace>
    <PackageId>TheSingularityWorkshop.Profiles</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>Trent Best</Authors>
    <Company>The Singularity Workshop</Company>
    <Description>Privacy-first profile, relationship, disclosure, representation, and assumption primitives.</Description>
    <PackageTags>profiles;privacy;identity;disclosure;relationships;assumptions;digital-identity</PackageTags>
    <RepositoryUrl>https://github.com/TrentBest/Profiles</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
